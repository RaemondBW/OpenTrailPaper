# Local development only. Copy to .env (gitignored) and `set -a; . ./.env; set +a`.
# In production every one of these is a Secret Manager secret mounted by
# deploy.sh; none of them belongs in the repo, a build flag, or an app bundle.

# https://www.strava.com/settings/api  (Authorization Callback Domain = the
# service's host, e.g. sync-auth-xxxxx-uc.a.run.app)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# https://ridewithgps.com/settings/developers  (OAuth redirect URI =
# https://<service host>/v1/auth/ridewithgps/callback)
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=
RWGPS_API_KEY=

# https://intervals.icu/oauth/apply  (redirect URI =
# https://<service host>/v1/auth/intervals/callback, scope ACTIVITY:WRITE)
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=

# 32 random bytes as hex: openssl rand -hex 32
HANDOFF_KEY=

# Optional. Derived from the request when unset (Cloud Run forwards host+proto).
# BASE_URL=https://sync-auth-xxxxx-uc.a.run.app
# APP_SCHEME=opentrailpaper
# PORT=8080
