# PlatformIO build output
.pio/

# Vendored LilyGO board support (re-clone into vendor/ — see project notes).
# No trailing slash: a git worktree has no vendor/ of its own and the usual fix
# is to symlink the main checkout's, which "vendor/" would not match.
vendor

# Editor / tooling
.vscode/
compile_commands.json

# macOS
.DS_Store

# Large regenerable map cache (refetch via tools/maps/build_map.py)
tools/maps/sf_overpass.json
*_overpass.json
tools/maps/__pycache__/
tools/__pycache__/

# Xcode user-specific state (the generated .xcodeproj itself is kept)
**/xcuserdata/
**/*.xcuserstate
companion-ios/DerivedData/

# Compiled preview-harness binary (rebuild via tools/preview/render_preview.sh)
tools/preview/preview

# FIT test-harness binary and the .fit files it emits (rebuild via
# tools/fit_test/run_fit_test.sh)
tools/fit_test/fit_test
tools/fit_test/ascent_test
tools/fit_test/out/

# Xcode archive / build output
companion-ios/build/

# Site images are generated at deploy time from tools/preview/out (see pages.yml).
# Uses docs/img/* rather than docs/img/ so the negations below work — git can't
# re-include a file whose parent *directory* is excluded.
docs/img/*
# ...except the brand icons, which are static assets, not generated screenshots.
!docs/img/favicon.png
!docs/img/favicon-32.png
!docs/img/apple-touch-icon.png
!docs/img/logo.png
companion-ios/build-sim/

# Host test binaries (built by the run_*.sh scripts)
tools/route_test/route_test
tools/map_test/roundtrip
tools/map_test/tilescene
tools/map_test/h3lookup
tools/fit_test/fit_test
tools/fit_test/ascent_test
tools/preview/preview

# Frames from tools/map_test/run_tilescene.sh. Unlike tools/preview/out these
# are not site images — they are a scratch pad for looking at one position, and
# the tiles that produced them are not in the repo either.
tools/map_test/out*/

# ESP-IDF build output and fetched components. Regenerable, ~750 MB, and not
# used by the PlatformIO build that actually ships — leftovers from the parked
# esp-idf port. These were committed once by an over-broad `git add`.
build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# clangd background index (regenerable, binary churn)
.cache/
tools/aux_test/aux_test

private_keys/*
